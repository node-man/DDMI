{
  "name": "ddmi",
  "version": "0.1.0",
  "description": "Document-Driven Memory Infrastructure — Drift monitor & integrity layer for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ddmi": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/cli/main.js serve --dashboard-only --watch",
    "dev:build": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "context-curation",
    "knowledge-infrastructure",
    "document-management",
    "audit-trail",
    "drift-detection",
    "markdown",
    "vector-search",
    "multi-agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@iarna/toml": "^2.2.5",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^4.0.0",
    "commander": "^13.0.0",
    "hono": "^4.12.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
