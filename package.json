{
  "name": "ddmi",
  "version": "0.2.0",
  "description": "Document-Driven Memory Infrastructure — Drift monitor & integrity layer for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ddmi": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/cli/main.js serve --dashboard-only --port 3001 --watch",
    "dev:client": "vite --config vite.config.client.ts",
    "build:client": "vite build --config vite.config.client.ts",
    "dev:build": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "context-curation",
    "knowledge-infrastructure",
    "document-management",
    "audit-trail",
    "drift-detection",
    "markdown",
    "vector-search",
    "multi-agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@iarna/toml": "^2.2.5",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "@xyflow/react": "^12.10.1",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.0.0",
    "diff2html": "^3.4.56",
    "drizzle-orm": "^0.45.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "hono": "^4.12.8",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^3.0.0"
  }
}
